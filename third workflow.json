    {
      "parameters": {
        "jsCode": "// Form se input data lena\nconst inputData = $input.first().json;\nconst durationText = inputData.Duration || \"30 min\"; // default agar empty ho\nlet durationInMinutes = 30;\n\nif (durationText.includes('min')) {\n  durationInMinutes = parseInt(durationText);\n} else if (durationText.includes('hr') || durationText.includes('hrs')) {\n  const hours = parseFloat(durationText);\n  durationInMinutes = hours * 60;\n}\n\nreturn {\n  json: {\n    ...inputData, // Purana saara form data sath chalega\n    durationInMinutes: durationInMinutes\n  }\n};"
      },
