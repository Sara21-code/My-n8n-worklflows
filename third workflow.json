    {
      "parameters": {
        "jsCode": "// Form se data nikalna\nconst emailField = $input.first().json.Attendees_Gmails || \"\";\n\n// Comma se alag karna aur extra spaces hatana\nconst emails = emailField.split(',').map(e => e.trim()).filter(e => e.length > 0);\n\n// Email check karne ka formula\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n// Galat emails filter karna\nconst invalidEmails = emails.filter(e => !emailRegex.test(e));\n\nreturn {\n  json: {\n    totalEmailsCount: emails.length,\n    validEmailsCount: emails.length - invalidEmails.length,\n    emails: emails,\n    invalidEmails: invalidEmails\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ],
      "id": "c575d8ae-73cd-4629-8013-8f4f3cf71347",
      "name": "Emails_Check"
    },
